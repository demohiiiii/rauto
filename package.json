{
  "name": "rauto-web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "npm run hooks:install || true",
    "hooks:install": "git config core.hooksPath .githooks",
    "format": "cargo fmt --all && npm run frontend:format",
    "format:check": "cargo fmt --all --check && npm run frontend:format:check",
    "clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "test": "cargo test --all-targets && npm run frontend:test",
    "frontend:test": "tsx --test \"frontend/tests/*.test.ts\"",
    "frontend:typecheck": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "frontend:format": "prettier --write \"frontend/**/*.{ts,svelte,css,html}\" package.json svelte.config.ts vite.config.ts tsconfig.json",
    "frontend:format:check": "prettier --check \"frontend/**/*.{ts,svelte,css,html}\" package.json svelte.config.ts vite.config.ts tsconfig.json",
    "frontend:dev": "vite --host 127.0.0.1",
    "frontend:build": "vite build",
    "frontend:preview": "vite preview --host 127.0.0.1",
    "web:build": "npm run frontend:build"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@~7.0.2",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@xyflow/svelte": "^1.6.6",
    "codemirror": "^6.0.2",
    "smol-toml": "^1.8.0",
    "svelte-codemirror-editor": "^2.1.0"
  }
}
